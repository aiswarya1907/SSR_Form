        </div>

    </section>


    <!-- SERVICES -->
    <section id="services" class="services section-padding">

        <div class="container">

            <div class="text-center text-white mb-5">

                <h2>Our Services</h2>

                <p>
                    Modern solutions for modern websites.
                </p>

            </div>


            <div class="row g-4">

                <div class="col-md-4">

                    <div class="service-card">

                        <h3>💻</h3>

                        <h4>Web Development</h4>

                        <p>
                            Modern websites created using HTML,
                            CSS and JavaScript.
                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="service-card">

                        <h3>🎨</h3>

                        <h4>UI Design</h4>

                        <p>
                            Clean and attractive interfaces
                            designed for a better user experience.
                        </p>

