            </div>

        </div>

    </section>


    <!-- CONTACT / YOUR EXISTING SSR FORM -->
    <section id="contact" class="section-padding contact">

        <div class="container">

            <div class="text-center mb-5">

                <h2>Contact Us</h2>

                <p class="text-muted">
                    Submit your information below.
                </p>

            </div>


            <div class="row justify-content-center">

                <div class="col-lg-6">

                    <div class="contact-card">

                        <!-- IMPORTANT:
                             This keeps your existing /submit route
                             working.
                        -->

       <form id="registrationForm" action="/submit" method="POST">

    <!-- FULL NAME -->
    <div class="mb-4">

        <label class="form-label">
            Full Name
        </label>

        <input
            type="text"
            id="name"
            name="name"
            class="form-control"
            placeholder="Enter your full name"
        >

        <span id="nameError" class="error"></span>

    </div>


    <!-- EMAIL -->
    <div class="mb-4">

        <label class="form-label">
            Email
        </label>

        <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="Enter your email"
        >

        <span id="emailError" class="error"></span>

    </div>


    <!-- PHONE -->
    <div class="mb-4">

        <label class="form-label">
            Phone Number
        </label>

        <input
            type="text"
            id="phone"
            name="phone"
            class="form-control"
            placeholder="Enter 10-digit phone number"
        >

        <span id="phoneError" class="error"></span>

    </div>


    <!-- PASSWORD -->
    <div class="mb-4">

        <label class="form-label">
            Password
        </label>

        <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            placeholder="Create a password"
        >

        <!-- Password strength -->
        <div class="strength-container mt-2">

            <div id="strengthBar"></div>

        </div>

        <p id="passwordStrength"
           class="text-start mt-2">
        </p>

        <span id="passwordError" class="error"></span>

    </div>


    <!-- CONFIRM PASSWORD -->
    <div class="mb-4">

        <label class="form-label">
            Confirm Password
        </label>

        <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            class="form-control"
            placeholder="Confirm your password"
        >

        <span
            id="confirmPasswordError"
            class="error">
        </span>

    </div>


    <!-- SKILLS -->
    <div class="mb-4">

        <label class="form-label">
            Skills
        </label>

        <div class="skill-section">

            <input
                type="text"
                id="skillInput"
                class="form-control"
                placeholder="Enter a skill"
            >

            <button
                type="button"
                onclick="addSkill()"
                class="btn btn-secondary">

                Add Skill

            </button>

        </div>

        <!-- Skills will appear here dynamically -->
        <ul id="skillList" class="mt-3"></ul>

        <!-- Sends skills to the server -->
        <input
            type="hidden"
            id="skills"
            name="skills"
        >

    </div>


    <!-- ABOUT -->
    <div class="mb-4">

        <label class="form-label">
            About Yourself
        </label>

        <textarea
            id="about"
            name="about"
            class="form-control"
            maxlength="200"
            placeholder="Tell us about yourself"></textarea>

        <p class="text-muted text-start mt-1">

            Characters:
            <span id="charCount">0</span>/200

        </p>

    </div>


    <!-- SUBMIT -->
    <button
        type="submit"
        class="btn btn-primary w-100 submit-btn">

        Submit Registration

    </button>

</form>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- FOOTER -->
    <footer>

        <div class="container text-center">

            <h5>WebDesign</h5>

