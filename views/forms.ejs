<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Registration</title>
</head>

<body style="
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
    margin: 0;
    padding: 40px;
">

    <div style="
        max-width: 500px;
        margin: auto;
        background: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    ">

        <h1 style="text-align:center; color:#333;">
            Student Registration
        </h1>

        <% if (message) { %>
            <p style="
                text-align:center;
                color:green;
                font-weight:bold;
            ">
                <%= message %>
            </p>
        <% } %>

        <form action="/submit" method="POST"
              onsubmit="return validateForm()">

            <label>Name:</label>

            <input type="text"
                   id="name"
                   name="name"
                   placeholder="Enter your name"
                   style="
                       width:100%;
                       padding:10px;
                       margin:8px 0 15px;
                       box-sizing:border-box;
                   ">

            <label>Email:</label>

            <input type="email"
                   id="email"
                   name="email"
                   placeholder="Enter your email"
                   style="
                       width:100%;
                       padding:10px;
                       margin:8px 0 15px;
                       box-sizing:border-box;
                   ">

            <label>Age:</label>

            <input type="number"
                   id="age"
                   name="age"
                   min="18"
                   placeholder="Enter your age"
                   style="
                       width:100%;
                       padding:10px;
                       margin:8px 0 15px;
                       box-sizing:border-box;
                   ">

            <label>Password:</label>

            <input type="password"
                   id="password"
                   name="password"
                   placeholder="Minimum 6 characters"
                   style="
                       width:100%;
                       padding:10px;
                       margin:8px 0 15px;
                       box-sizing:border-box;
                   ">

            <label>Choose Course:</label>

            <select id="course"
                    name="course"
                    style="
                        width:100%;
                        padding:10px;
                        margin:8px 0 20px;
                    ">

                <option value="">Select a course</option>
                <option value="Computer Science">
                    Computer Science
                </option>

                <option value="Data Science">
                    Data Science
                </option>

                <option value="Web Development">
                    Web Development
                </option>

            </select>

            <button type="submit"
                    style="
                        width:100%;
                        padding:12px;
                        background-color:#007bff;
                        color:white;
                        border:none;
                        border-radius:5px;
                        cursor:pointer;
                    "
                    onmouseover="this.style.backgroundColor='#0056b3'"
                    onmouseout="this.style.backgroundColor='#007bff'">

                Submit

            </button>

        </form>

        <% if (users.length > 0) { %>

            <h2 style="margin-top:30px;">
                Registered Students
            </h2>

            <% users.forEach(user => { %>

                <div style="
                    background:#f5f5f5;
                    padding:10px;
                    margin:10px 0;
                    border-radius:5px;
                ">

                    <strong><%= user.name %></strong><br>
                    Email: <%= user.email %><br>
                    Age: <%= user.age %><br>
                    Course: <%= user.course %>

                </div>

            <% }); %>

        <% } %>

    </div>

    <script>

        function validateForm() {

            const name =
                document.getElementById("name").value.trim();

            const email =
                document.getElementById("email").value.trim();

            const age =
                document.getElementById("age").value;

            const password =
                document.getElementById("password").value;

            const course =
                document.getElementById("course").value;

            if (name === "") {
                alert("Please enter your name.");
                return false;
            }

            if (!email.includes("@")) {
                alert("Please enter a valid email.");
                return false;
            }

            if (age < 18) {
                alert("You must be at least 18 years old.");
                return false;
            }

            if (password.length < 6) {
                alert("Password must contain at least 6 characters.");
                return false;
            }

            if (course === "") {
                alert("Please select a course.");
                return false;
            }

            return true;
        }

    </script>

</body>
</html>