<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Country API Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">

    <div class="container py-5">

        <!-- HEADER -->
        <div class="text-center mb-5">

            <h1>🌍 Country Information</h1>

            <p class="text-muted">
                External API Integration using Node.js and REST API
            </p>

            <a href="/students" class="btn btn-secondary">
                ← Student Dashboard
            </a>

            <a href="/logout" class="btn btn-danger">
                Logout
            </a>

        </div>


        <!-- SEARCH CARD -->
        <div class="card shadow p-4 mb-4">

            <h3 class="mb-3">
                Search Country
            </h3>

            <div class="input-group">

                <input
                    type="text"
                    id="countryName"
                    class="form-control"
                    placeholder="Enter country name"
                    onkeypress="handleEnter(event)">

                <button
                    class="btn btn-primary"
                    onclick="searchCountry()">

                    Search

                </button>

            </div>

        </div>


        <!-- LOADING -->
        <div
            id="loading"
            class="text-center"
            style="display: none;">

            <div class="spinner-border text-primary"></div>

            <p class="mt-2">
                Fetching country information...
            </p>

        </div>


        <!-- ERROR -->
        <div
            id="errorMessage"
            class="alert alert-danger"
            style="display: none;">
        </div>


        <!-- RESULT -->
        <div
            id="countryResult"
            class="card shadow p-4"
            style="display: none;">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 id="country"></h2>

                    <hr>

                    <p>
                        <strong>Capital:</strong>
                        <span id="capital"></span>
                    </p>

                    <p>
                        <strong>Region:</strong>
                        <span id="region"></span>
                    </p>

                    <p>
                        <strong>Population:</strong>
                        <span id="population"></span>
                    </p>

                    <p>
                        <strong>Currency:</strong>
                        <span id="currency"></span>
                    </p>

                </div>

                <div class="col-md-4 text-center">

                    <img
                        id="flag"
                        src=""
                        alt="Country Flag"
                        class="img-fluid"
                        style="max-width: 180px;">

                </div>

            </div>

        </div>

    </div>


    <script>

        function handleEnter(event) {

            if (event.key === "Enter") {
                searchCountry();
            }

        }


        async function searchCountry() {

            const countryName =
                document.getElementById("countryName").value.trim();

            const loading =
                document.getElementById("loading");

            const errorMessage =
                document.getElementById("errorMessage");

            const countryResult =
                document.getElementById("countryResult");


            // Validate input
            if (!countryName) {

                errorMessage.textContent =
                    "Please enter a country name.";

                errorMessage.style.display = "block";

                countryResult.style.display = "none";

                return;
            }


            // Reset previous messages
            errorMessage.style.display = "none";

            countryResult.style.display = "none";

            loading.style.display = "block";


            try {

                const response =
                    await fetch(
                        `/api/country/${encodeURIComponent(countryName)}`
                    );


                const data =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        data.message ||
                        "Failed to fetch country information."
                    );

                }


                // Display data
                document.getElementById("country")
                    .textContent = data.name;

                document.getElementById("capital")
                    .textContent = data.capital;

                document.getElementById("region")
                    .textContent = data.region;

                document.getElementById("population")
                    .textContent =
                    Number(data.population).toLocaleString();

                document.getElementById("currency")
                    .textContent = data.currency;
const flagElement = document.getElementById("flag");

if (data.flagUrl) {
    flagElement.src = data.flagUrl;
    flagElement.style.display = "block";
} else {
    flagElement.style.display = "none";
}
                countryResult.style.display = "block";

            }

            catch (error) {

                console.error(error);

                errorMessage.textContent =
                    error.message ||
                    "Unable to fetch country information.";

                errorMessage.style.display = "block";

            }

            finally {

                loading.style.display = "none";

            }

        }

    </script>

</body>

</html>